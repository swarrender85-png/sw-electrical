/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Every asset URL carries a ?v=N query string driven by ASSET_V in build.py,
# so a changed file is always a changed URL. That makes it safe to cache these
# for a year: browsers keep them until ASSET_V is bumped, at which point the
# new URL is a cache miss and fetches fresh.
#
# THIS DEPENDS ON BUMPING ASSET_V ON EVERY CSS/JS CHANGE. Edit an asset without
# bumping it and returning visitors keep the old file for up to a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must always revalidate: these URLs never change, so they are how a
# visitor discovers that ASSET_V moved and new assets exist.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
